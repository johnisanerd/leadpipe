      "typeVersion": 3.4,
      "position": [240, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.api_base }}/enrich/site/{{ $('Config').item.json.site_id }}?headless=true",
        "options": { "timeout": 300000 }
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000003",
      "name": "1 Enrich",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.api_base }}/forms/collect/site/{{ $('Config').item.json.site_id }}?headless=true",
        "options": { "timeout": 300000 }
      },
      "id": "c1b2c3d4-0004-4000-8000-000000000004",
      "name": "2 Collect Form",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.api_base }}/outreach/generate/site/{{ $('Config').item.json.site_id }}?auto_qualify=true&skip_unqualified=true",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"offer_description\": {{ JSON.stringify($('Config').item.json.offer_description) }},\n  \"sender_name\": {{ JSON.stringify($('Config').item.json.sender_name) }},\n  \"sender_company\": {{ JSON.stringify($('Config').item.json.sender_company) }},\n  \"sender_phone\": {{ JSON.stringify($('Config').item.json.sender_phone) }},\n  \"sender_email\": {{ JSON.stringify($('Config').item.json.sender_email) }}\n}",
        "options": { "timeout": 300000 }
      },
      "id": "c1b2c3d4-0005-4000-8000-000000000005",
      "name": "3 Generate Outreach",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "done",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c1b2c3d4-0006-4000-8000-000000000006",
      "name": "Outreach OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1200, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.api_base }}/outreach/submit/site/{{ $('Config').item.json.site_id }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"sender_name\": {{ JSON.stringify($('Config').item.json.sender_name) }},\n  \"sender_phone\": {{ JSON.stringify($('Config').item.json.sender_phone) }},\n  \"sender_email\": {{ JSON.stringify($('Config').item.json.sender_email) }},\n  \"dry_run\": {{ $('Config').item.json.dry_run_submit }},\n  \"headless\": true\n}",
        "options": { "timeout": 300000 }
      },
      "id": "c1b2c3d4-0007-4000-8000-000000000007",
      "name": "4 Submit Form",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 300]
    },
    {
