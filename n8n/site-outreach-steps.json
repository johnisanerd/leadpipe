            }
          ]
        },
        "options": {}
      },
      "id": "c1b2c3d4-0008-4000-8000-000000000008",
      "name": "Skipped",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1440, 520]
    }
  ],
  "connections": {
